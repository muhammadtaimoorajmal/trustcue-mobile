# ==============================================================================
# TrustCue Backend Service - Example Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual secret keys or .env files to source control.
# ==============================================================================

# --- Application Runtime & Environment ---
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=false
DOCS_ENABLED=true

# --- Security & CORS ---
# Explicit comma-separated allowed browser origins.
# Leave empty for non-browser mobile native clients. Never set to wildcard "*".
CORS_ALLOWED_ORIGINS=

# --- Logging & Telemetry ---
# Minimal operational logging level: DEBUG, INFO, WARNING, ERROR.
# Routine logs NEVER record message content, queries, or SHA-256 hashes.
LOG_LEVEL=INFO

# --- Request Body & Operational Limits ---
# Maximum request body size in bytes (default: 1 MB = 1000000 bytes)
MAX_REQUEST_BODY_BYTES=1000000

# --- Feature Flags (All cloud services disabled in Module 28 foundation) ---
ENABLE_CLOUD_AI=false
ENABLE_CLOUD_AUTH=false
ENABLE_CLOUD_SYNC=false

# --- Cloud Credentials (OPTIONAL - Not required for Module 28 foundation) ---
# Supabase Configuration (Planned Modules 29-31)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Configuration (Implemented Module 33)
# Primary: Groq Cloud API (Free tier: 30 RPM, 1,000 RPD, 12k TPM, 100k TPD)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=15.0
GROQ_MAX_TOKENS=1024

# Secondary: Google Gemini API (Strictly synthetic data on unpaid free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
